---
// Par de CTAs padrão do site. Os dois botões abrem o MESMO quiz (LeadQuiz,
// global pelo BaseLayout); o que muda é o evento disparado no clique, para o
// Google Ads medir duas conversões separadas:
//   azul   → data-cta="simular-orcamento" → evento cta_simular_orcamento
//   vazado → data-cta="agendar-consulta"  → evento cta_agendar_consulta
// O clique é tratado por um handler único no BaseLayout (delegação), então não
// há script por componente nem listener duplicado.
//   <CtaPair tratamento="Implantes Dentários" />   fundo claro
//   <CtaPair dark />                               fundo navy
interface Props {
  tratamento?: string;
  objetivo?: string;
  dark?: boolean;
  full?: boolean;
  class?: string;
}
const { tratamento = "", objetivo = "", dark = false, full = false, class: cls = "" } = Astro.props;
const fill = dark ? "btn-teal" : "btn-primary";
const outline = dark ? "btn-outline-light" : "btn-outline";
---

<div class:list={["cta-pair", full && "cta-pair-full", cls]}>
  <button type="button" class={`btn ${fill}`} data-cta="simular-orcamento" data-trat={tratamento} data-obj={objetivo}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M8 6h8M8 11h2m4 0h2M8 16h2m4 0h2"/></svg>
    Quero simular o orçamento
  </button>
  <button type="button" class={`btn ${outline}`} data-cta="agendar-consulta" data-trat={tratamento} data-obj={objetivo}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/></svg>
    Quero agendar consulta
  </button>
</div>
