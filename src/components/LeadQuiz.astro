---
// Quiz de lead em 3 etapas → WhatsApp. 100% client, sem backend (só localStorage
// para lembrar nome/telefone na sessão). Etapa 1 capta nome + WhatsApp, etapa 2
// qualifica o objetivo/horário, etapa 3 monta a mensagem e abre o WhatsApp da
// clínica já com o contexto. Inclua UMA vez por página (já vem global pelo
// BaseLayout). Abra de qualquer lugar com window.gopQuiz.open({ tratamento, objetivo }).
---

<div class="lq-overlay" id="lqOverlay" hidden aria-hidden="true">
  <div class="lq-card" role="dialog" aria-modal="true" aria-labelledby="lqTitle">
    <button class="lq-close" id="lqClose" aria-label="Fechar">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>

    <div class="lq-head">
      <span class="lq-eyebrow">Agende em 1 minuto</span>
      <h3 id="lqTitle">Vamos cuidar do seu sorriso</h3>
      <p class="lq-interesse" id="lqInteresse" hidden></p>
    </div>

    <ol class="lq-steps" id="lqSteps" aria-label="Etapas">
      <li data-s="1">Contato</li>
      <li data-s="2">Seu objetivo</li>
      <li data-s="3">WhatsApp</li>
    </ol>

    <div class="lq-step" data-step="1">
      <label class="lq-label" for="lqNome">Seu nome</label>
      <input type="text" id="lqNome" class="lq-input" autocomplete="given-name" placeholder="Como podemos te chamar?" />
      <p class="lq-err" id="lqErrNome" role="alert"></p>

      <label class="lq-label" for="lqTel">Seu WhatsApp com DDD</label>
      <input type="tel" id="lqTel" class="lq-input" autocomplete="tel-national" inputmode="numeric" placeholder="(11) 90000-0000" />
      <p class="lq-err" id="lqErrTel" role="alert"></p>

      <p class="lq-note">Seus dados são usados apenas pela GOP Implantes para falar com você sobre a sua avaliação, conforme a LGPD.</p>
    </div>

    <div class="lq-step" data-step="2" hidden>
      <fieldset class="lq-fieldset">
        <legend class="lq-q">Quantos dentes estão faltando hoje?</legend>
        <div class="lq-chips" id="lqTeeth">
          <button type="button" class="lq-chip" data-val="1 dente" data-faixa="C" data-value="50">1 dente</button>
          <button type="button" class="lq-chip" data-val="De 2 a 5 dentes" data-faixa="B" data-value="150">De 2 a 5 dentes</button>
          <button type="button" class="lq-chip" data-val="Mais de 5 dentes" data-faixa="A" data-value="300">Mais de 5 dentes</button>
          <button type="button" class="lq-chip" data-val="Uso dentadura ou prótese móvel" data-faixa="A" data-value="300">Uso dentadura ou prótese móvel</button>
        </div>
      </fieldset>

      <fieldset class="lq-fieldset">
        <legend class="lq-q">Qual é o seu objetivo?</legend>
        <div class="lq-chips" id="lqGoals">
          <button type="button" class="lq-chip" data-val="Recuperar um dente perdido">Recuperar um dente perdido</button>
          <button type="button" class="lq-chip" data-val="Alinhar os dentes">Alinhar os dentes</button>
          <button type="button" class="lq-chip" data-val="Estética e clareamento do sorriso">Estética / clarear o sorriso</button>
          <button type="button" class="lq-chip" data-val="Dor ou urgência">Dor ou urgência</button>
          <button type="button" class="lq-chip" data-val="Check-up e limpeza">Check-up e limpeza</button>
          <button type="button" class="lq-chip" data-val="Outro assunto">Outro</button>
        </div>
      </fieldset>

      <fieldset class="lq-fieldset">
        <legend class="lq-q">Melhor horário para falarmos?</legend>
        <div class="lq-chips" id="lqTimes">
          <button type="button" class="lq-chip" data-val="De manhã">De manhã</button>
          <button type="button" class="lq-chip" data-val="À tarde">À tarde</button>
          <button type="button" class="lq-chip" data-val="À noite">À noite</button>
          <button type="button" class="lq-chip" data-val="Qualquer horário">Qualquer horário</button>
        </div>
      </fieldset>
      <p class="lq-err" id="lqErrQ" role="alert"></p>
    </div>

    <div class="lq-step" data-step="3" hidden>
      <p class="lq-lead" id="lqLead3">Recebemos suas respostas 🙂</p>
      <dl class="lq-recap" id="lqRecap"></dl>
      <a class="lq-go" id="lqGo" href="#" target="_blank" rel="noopener" data-direct-wpp>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2Zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.6-2.7-1.2-4.5-3.9-4.6-4.1-.1-.2-1.1-1.4-1.1-2.7 0-1.3.7-1.9 .9-2.2.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.4 0 .5l-.4.6c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2 .8.5 1.1.6 1.4.5.2-.1.4-.4.6-.7.2-.3.4-.2.6-.2l1.7.8c.2.1.4.2.4.4.1.2.1.9-.1 1.5Z"/></svg>
        Falar no WhatsApp agora
      </a>
      <p class="lq-alt">Prefere esperar? Nossa equipe te chama no número <strong id="lqTelRecap"></strong> em horário comercial.</p>
    </div>

    <div class="lq-foot">
      <button type="button" class="lq-back" id="lqBack" hidden>Voltar</button>
      <button type="button" class="lq-next" id="lqNext">Continuar</button>
    </div>
  </div>
</div>

<style is:global>
  /* com o modal aberto: trava o scroll e PAUSA as animações de fundo, senão o
     backdrop-filter reborra o fundo animado (marquee/aurora) a cada frame e
     trava no desktop (viewport grande). */
  body.lq-open{ overflow:hidden; }
  body.lq-open .aurora span,
  body.lq-open .marquee-track,
  body.lq-open .fk-fab{ animation-play-state:paused !important; }
  .lq-overlay{ position:fixed; inset:0; z-index:200; display:none; align-items:center; justify-content:center; padding:20px; background:rgba(11,24,40,.55); backdrop-filter:blur(4px); -webkit-backdrop-filter:blur(4px); }
  .lq-overlay.open{ display:flex; animation:lqFade .2s ease; }
  @keyframes lqFade{ from{opacity:0} to{opacity:1} }
  .lq-card{ position:relative; width:100%; max-width:480px; background:var(--cream); border-radius:24px; box-shadow:0 40px 90px -30px rgba(11,24,40,.6); padding:30px 26px 24px; max-height:calc(100vh - 40px); overflow:auto; animation:lqUp .26s cubic-bezier(.2,.8,.2,1); }
  @keyframes lqUp{ from{transform:translateY(14px); opacity:0} to{transform:none; opacity:1} }
  .lq-close{ position:absolute; top:14px; right:14px; width:36px; height:36px; display:grid; place-items:center; border:0; border-radius:50%; background:var(--sand); color:var(--navy); cursor:pointer; transition:.2s; z-index:2; }
  .lq-close:hover{ background:var(--navy); color:#fff; }
  .lq-head{ margin-bottom:16px; padding-right:24px; }
  .lq-eyebrow{ font-family:'Manrope',sans-serif; font-weight:700; font-size:.74rem; letter-spacing:.14em; text-transform:uppercase; color:var(--teal); }
  .lq-head h3{ font-family:'Poppins',sans-serif; font-weight:600; color:var(--navy-deep); font-size:1.5rem; margin:6px 0 0; line-height:1.15; }
  .lq-interesse{ margin:10px 0 0; font-size:.86rem; color:var(--navy); background:var(--sand); border-radius:10px; padding:7px 12px; display:inline-block; }

  /* progresso: sequência real de 3 passos */
  .lq-steps{ display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin-bottom:22px; list-style:none; }
  .lq-steps li{ font-family:'Manrope',sans-serif; font-size:.74rem; font-weight:700; color:var(--muted); padding-top:9px; border-top:3px solid var(--line); transition:border-color .3s,color .3s; }
  .lq-steps li.on{ border-color:var(--teal); color:var(--navy-deep); }
  .lq-steps li.done{ border-color:var(--sky); }

  .lq-step{ display:block; }
  .lq-step[hidden]{ display:none; }
  @keyframes lqStepIn{ from{opacity:0; transform:translateY(8px)} to{opacity:1; transform:none} }
  .lq-step{ animation:lqStepIn .3s ease; }
  @media (prefers-reduced-motion:reduce){ .lq-step{ animation:none; } .lq-steps li{ transition:none; } }

  .lq-label{ display:block; font-family:'Manrope',sans-serif; font-weight:700; color:var(--ink); margin-bottom:8px; font-size:.94rem; }
  .lq-input{ width:100%; font-family:'Manrope',sans-serif; font-size:16px; color:var(--ink); background:#fff; border:1.5px solid var(--line); border-radius:14px; padding:14px 16px; margin-bottom:6px; outline:none; transition:.18s; }
  .lq-input::placeholder{ color:var(--muted); }
  .lq-input:focus{ border-color:var(--teal); box-shadow:0 0 0 4px rgba(42,147,184,.1); }
  .lq-err{ min-height:20px; font-size:.82rem; color:#c0392b; margin:0 0 8px; }
  .lq-note{ font-size:.8rem; color:var(--muted); margin-top:10px; line-height:1.5; }

  .lq-fieldset{ border:0; margin:0 0 20px; }
  .lq-fieldset:last-of-type{ margin-bottom:0; }
  .lq-q{ font-family:'Poppins',sans-serif; font-weight:600; color:var(--navy-deep); font-size:1rem; margin:0 0 12px; line-height:1.3; }
  .lq-chips{ display:flex; flex-wrap:wrap; gap:9px; }
  .lq-chip{ font-family:'Manrope',sans-serif; font-size:.9rem; font-weight:600; color:var(--ink); background:#fff; border:1.5px solid var(--line); border-radius:100px; padding:10px 16px; cursor:pointer; transition:.18s; }
  .lq-chip:hover{ border-color:var(--teal); }
  .lq-chip.sel{ background:var(--navy); border-color:var(--navy); color:#fff; }

  .lq-lead{ font-family:'Poppins',sans-serif; font-weight:600; color:var(--navy-deep); font-size:1.08rem; margin:0 0 16px; line-height:1.35; }
  .lq-recap{ background:#fff; border:1px solid var(--line); border-left:4px solid var(--teal); border-radius:14px; padding:16px 18px; margin:0 0 20px; }
  .lq-recap dt{ font-family:'Manrope',sans-serif; color:var(--muted); font-size:.76rem; text-transform:uppercase; letter-spacing:.06em; font-weight:700; }
  .lq-recap dd{ margin:2px 0 10px; font-weight:600; color:var(--ink); }
  .lq-recap dd:last-child{ margin-bottom:0; }
  .lq-alt{ font-size:.86rem; color:var(--muted); margin-top:16px; line-height:1.5; text-align:center; }
  .lq-alt strong{ color:var(--ink); }

  .lq-go{ display:flex; align-items:center; justify-content:center; gap:10px; width:100%; min-height:62px; font-family:'Manrope',sans-serif; font-weight:700; font-size:1rem; color:#fff; background:#25d366; border-radius:100px; text-decoration:none; box-shadow:0 16px 34px -14px rgba(37,211,102,.65); transition:.2s; }
  .lq-go:hover{ background:#1ebe5d; transform:translateY(-2px); }
  .lq-go svg{ flex-shrink:0; }

  .lq-foot{ display:flex; align-items:center; justify-content:flex-end; gap:14px; margin-top:24px; }
  .lq-back{ font-family:'Manrope',sans-serif; font-weight:600; font-size:.9rem; color:var(--muted); background:none; border:0; cursor:pointer; padding:11px 8px; margin-right:auto; }
  .lq-back:hover{ color:var(--ink); }
  .lq-next{ font-family:'Manrope',sans-serif; font-weight:700; font-size:.92rem; color:#fff; background:linear-gradient(135deg,var(--navy),var(--teal)); border:0; border-radius:100px; padding:14px 28px; cursor:pointer; transition:.2s; }
  .lq-next:hover{ transform:translateY(-2px); box-shadow:0 16px 30px -16px rgba(42,147,184,.6); }

  @media (max-width:480px){
    .lq-card{ padding:26px 18px 18px; border-radius:20px; }
    .lq-head h3{ font-size:1.32rem; }
    .lq-next{ width:100%; justify-content:center; }
    .lq-foot{ flex-wrap:wrap; }
    .lq-back{ margin-right:0; order:2; width:100%; text-align:center; }
  }
</style>

<script>
  (() => {
    const overlay = document.getElementById("lqOverlay");
    if (!overlay || window.gopQuiz) return; // só inicializa uma vez

    const steps = [...overlay.querySelectorAll(".lq-step")];
    const stepsNav = [...document.getElementById("lqSteps").children];
    const teethWrap = document.getElementById("lqTeeth");
    const goalsWrap = document.getElementById("lqGoals");
    const timesWrap = document.getElementById("lqTimes");
    const nomeInput = document.getElementById("lqNome");
    const telInput = document.getElementById("lqTel");
    const errNome = document.getElementById("lqErrNome");
    const errTel = document.getElementById("lqErrTel");
    const errQ = document.getElementById("lqErrQ");
    const interesse = document.getElementById("lqInteresse");
    const lead3 = document.getElementById("lqLead3");
    const recap = document.getElementById("lqRecap");
    const telRecap = document.getElementById("lqTelRecap");
    const btnBack = document.getElementById("lqBack");
    const btnNext = document.getElementById("lqNext");
    const btnGo = document.getElementById("lqGo");
    const WPP = "5511985140604";
    const WEBHOOK_URL = import.meta.env.PUBLIC_LEAD_WEBHOOK_URL;

    // gclid/gbraid/wbraid/UTMs: pega da querystring da primeira página em que o
    // lead caiu e guarda em sessionStorage, pra acompanhar ele até o fim do quiz
    // mesmo que ele navegue por outras páginas do site antes de converter.
    function captureAttribution() {
      const keys = ["gclid", "gbraid", "wbraid", "utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content"];
      const fromUrl = {};
      const params = new URLSearchParams(location.search);
      let found = false;
      keys.forEach((k) => { const v = params.get(k); if (v) { fromUrl[k] = v; found = true; } });
      try {
        if (found) { sessionStorage.setItem("gop_attribution", JSON.stringify(fromUrl)); return fromUrl; }
        const stored = sessionStorage.getItem("gop_attribution");
        if (stored) return JSON.parse(stored);
      } catch (e) {}
      return fromUrl;
    }
    const attribution = captureAttribution();

    function sendWebhook(event, data) {
      const payload = Object.assign({ event: event, page_url: location.href }, data);
      if (!WEBHOOK_URL) {
        if (import.meta.env.DEV) console.log("[lead webhook]", payload);
        return;
      }
      try {
        fetch(WEBHOOK_URL, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          keepalive: true,
          body: JSON.stringify(payload),
        }).catch(() => {});
      } catch (e) {}
    }

    const state = {
      step: 1, nome: "", telefone: "", dentes: "", faixa: "", valorConversao: 0,
      objetivo: "", horario: "", tratamento: "", origem: "",
      leadId: "", sentStep1: false, sentStep2: false, sentWa: false,
    };

    function selectChip(wrap, val) {
      [...wrap.children].forEach((c) => c.classList.toggle("sel", c.dataset.val === val));
    }

    // máscara de telefone BR: (11) 90000-0000
    telInput.addEventListener("input", () => {
      let d = telInput.value.replace(/\D/g, "").slice(0, 11);
      let o = d;
      if (d.length > 2) o = "(" + d.slice(0, 2) + ") " + d.slice(2);
      if (d.length > 7) o = "(" + d.slice(0, 2) + ") " + d.slice(2, 7) + "-" + d.slice(7);
      telInput.value = o;
    });

    function render() {
      steps.forEach((s) => (s.hidden = Number(s.dataset.step) !== state.step));
      stepsNav.forEach((li) => {
        const s = Number(li.dataset.s);
        li.classList.toggle("on", s === state.step);
        li.classList.toggle("done", s < state.step);
      });
      btnBack.hidden = state.step === 1;
      const last = state.step === 3;
      btnNext.hidden = last;
      if (state.step === 1) setTimeout(() => nomeInput.focus(), 60);
    }

    function buildLink() {
      let msg = `Olá! Sou ${state.nome}. Vim pelo site da GOP Implantes 🦷`;
      if (state.tratamento) msg += `\nTenho interesse em: ${state.tratamento}`;
      if (state.objetivo) msg += `\nMeu objetivo: ${state.objetivo}`;
      if (state.horario) msg += `\nMelhor horário para contato: ${state.horario}`;
      if (state.origem) msg += `\nVim por: ${state.origem}`;
      msg += `\nMeu WhatsApp: ${state.telefone}`;
      msg += `\nGostaria de agendar uma avaliação. 🙂`;
      return `https://wa.me/${WPP}?text=${encodeURIComponent(msg)}`;
    }

    function showRecap() {
      const primeiro = state.nome.split(" ")[0] || "";
      lead3.textContent = (primeiro ? primeiro.charAt(0).toUpperCase() + primeiro.slice(1) + ", recebemos" : "Recebemos") + " suas respostas 🙂";
      recap.innerHTML = "";
      const linhas = [];
      if (state.tratamento) linhas.push(["Tratamento", state.tratamento]);
      if (state.dentes) linhas.push(["Dentes faltando", state.dentes]);
      if (state.objetivo) linhas.push(["Objetivo", state.objetivo]);
      if (state.horario) linhas.push(["Melhor horário", state.horario]);
      if (state.origem) linhas.push(["Veio por", state.origem]);
      linhas.forEach(([k, v]) => {
        const dt = document.createElement("dt"); dt.textContent = k;
        const dd = document.createElement("dd"); dd.textContent = v;
        recap.append(dt, dd);
      });
      telRecap.textContent = state.telefone;
      btnGo.href = buildLink();
    }

    // conversão Google Ads da Etapa 1 (primária): telefone p/ conversões otimizadas
    // + evento, uma vez por preenchimento (guardado em state.sentStep1)
    function fireStep1Conversion(phoneE164) {
      if (state.sentStep1) return;
      state.sentStep1 = true;
      if (typeof window.gtag === "function") {
        window.gtag("set", "user_data", { phone_number: phoneE164 });
        window.gtag("event", "conversion", {
          send_to: "AW-10906767237/2cKzCJHqrYAdEIWf4NAo",
          transaction_id: state.leadId + "-e1",
        });
      }
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: "gop_lead_etapa1", lead_id: state.leadId });
      sendWebhook("lead_etapa1", Object.assign({
        lead_id: state.leadId, nome: state.nome, telefone: phoneE164,
      }, attribution));
    }

    // conversão Google Ads da Etapa 2 (secundária, com valor conforme a faixa do lead)
    function fireStep2Conversion(phoneE164) {
      if (state.sentStep2) return;
      state.sentStep2 = true;
      if (typeof window.gtag === "function") {
        window.gtag("event", "conversion", {
          send_to: "AW-10906767237/7vIICIvqrYAdEIWf4NAo",
          value: state.valorConversao,
          currency: "BRL",
          transaction_id: state.leadId,
        });
      }
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: "gop_lead_qualificado", lead_id: state.leadId, faixa: state.faixa, value: state.valorConversao });
      sendWebhook("lead_qualificado", Object.assign({
        lead_id: state.leadId, nome: state.nome, telefone: phoneE164,
        dentes: state.dentes, objetivo: state.objetivo, horario: state.horario,
        faixa: state.faixa, value: state.valorConversao,
      }, attribution));
    }

    // conversão Google Ads do clique no WhatsApp (secundária)
    function fireWhatsappConversion() {
      if (state.sentWa) return;
      state.sentWa = true;
      if (typeof window.gtag === "function") {
        window.gtag("event", "conversion", {
          send_to: "AW-10906767237/IREGCI7qrYAdEIWf4NAo",
          transaction_id: state.leadId + "-wa",
        });
      }
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: "gop_whatsapp_click", lead_id: state.leadId });
      sendWebhook("whatsapp_click", { lead_id: state.leadId });
    }

    // ETAPA 1 → nome + telefone
    function goStep2() {
      const nome = nomeInput.value.trim();
      const digits = telInput.value.replace(/\D/g, "");
      let ok = true;
      errNome.textContent = ""; errTel.textContent = "";
      if (nome.length < 2) { errNome.textContent = "Digite seu nome para continuar."; ok = false; }
      if (!/^\d{2}9\d{8}$/.test(digits)) { errTel.textContent = "Confira o número: DDD + 9 dígitos do celular."; ok = false; }
      if (!ok) return;
      state.nome = nome;
      state.telefone = "(" + digits.slice(0, 2) + ") " + digits.slice(2, 7) + "-" + digits.slice(7);
      try { localStorage.setItem("gop_lead_nome", state.nome); localStorage.setItem("gop_lead_tel", telInput.value); } catch (e) {}
      state.step = 2;
      render();
      fireStep1Conversion("+55" + digits);
    }

    // ETAPA 2 → dentes faltando + objetivo + horário
    function goStep3() {
      errQ.textContent = "";
      if (!state.dentes || !state.objetivo || !state.horario) {
        errQ.textContent = "Escolha uma opção em cada pergunta para seguir.";
        return;
      }
      state.step = 3;
      showRecap();
      render();
      const digits = telInput.value.replace(/\D/g, "");
      fireStep2Conversion("+55" + digits);
    }

    teethWrap.addEventListener("click", (e) => {
      const b = e.target.closest(".lq-chip"); if (!b) return;
      state.dentes = b.dataset.val; state.faixa = b.dataset.faixa; state.valorConversao = Number(b.dataset.value);
      selectChip(teethWrap, state.dentes);
    });
    goalsWrap.addEventListener("click", (e) => {
      const b = e.target.closest(".lq-chip"); if (!b) return;
      state.objetivo = b.dataset.val; selectChip(goalsWrap, state.objetivo);
    });
    timesWrap.addEventListener("click", (e) => {
      const b = e.target.closest(".lq-chip"); if (!b) return;
      state.horario = b.dataset.val; selectChip(timesWrap, state.horario);
    });

    btnNext.addEventListener("click", () => {
      if (state.step === 1) goStep2();
      else if (state.step === 2) goStep3();
    });
    btnBack.addEventListener("click", () => { if (state.step > 1) { state.step--; render(); } });
    btnGo.addEventListener("click", () => {
      // lead concluído: evento único, com a origem do CTA que abriu o quiz
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: "lead_whatsapp", cta_origem: state.origem, tratamento: state.tratamento });
      if (typeof window.gtag === "function") window.gtag("event", "lead_whatsapp", { cta_origem: state.origem, tratamento: state.tratamento });
      fireWhatsappConversion();
      close();
    });

    function open(opts = {}) {
      state.step = 1;
      state.objetivo = opts.objetivo || "";
      state.horario = "";
      state.dentes = ""; state.faixa = ""; state.valorConversao = 0;
      state.tratamento = opts.tratamento || "";
      state.origem = opts.origem || "";
      state.leadId = (crypto.randomUUID ? crypto.randomUUID() : Date.now() + "-" + Math.random().toString(36).slice(2));
      state.sentStep1 = false; state.sentStep2 = false; state.sentWa = false;
      errNome.textContent = ""; errTel.textContent = ""; errQ.textContent = "";
      if (state.objetivo) selectChip(goalsWrap, state.objetivo); else selectChip(goalsWrap, "");
      selectChip(timesWrap, "");
      selectChip(teethWrap, "");
      try {
        nomeInput.value = localStorage.getItem("gop_lead_nome") || "";
        telInput.value = localStorage.getItem("gop_lead_tel") || "";
      } catch (e) { nomeInput.value = ""; telInput.value = ""; }
      interesse.hidden = !state.tratamento;
      if (state.tratamento) interesse.textContent = "Interesse: " + state.tratamento;
      overlay.hidden = false; overlay.setAttribute("aria-hidden", "false");
      // pausa animações de fundo e trava o scroll; compensa a barra p/ não "pular"
      const sbw = window.innerWidth - document.documentElement.clientWidth;
      if (sbw > 0) document.body.style.paddingRight = sbw + "px";
      document.body.classList.add("lq-open");
      requestAnimationFrame(() => overlay.classList.add("open"));
      render();
    }
    function close() {
      overlay.classList.remove("open");
      overlay.setAttribute("aria-hidden", "true");
      document.body.classList.remove("lq-open");
      document.body.style.paddingRight = "";
      setTimeout(() => (overlay.hidden = true), 180);
    }

    document.getElementById("lqClose").addEventListener("click", close);
    overlay.addEventListener("click", (e) => { if (e.target === overlay) close(); });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && overlay.classList.contains("open")) close(); });

    window.gopQuiz = { open, close };

    // Intercepta QUALQUER botão/link de WhatsApp do site e abre o quiz antes
    // (qualifica o lead -> depois vai pro WhatsApp). Exceções: o botão do próprio
    // quiz (#lqOverlay / data-direct-wpp) e os links do chat assistente (#fkChat).
    // Em páginas de tratamento, pré-preenche o tratamento (lê o .art-title).
    document.addEventListener("click", (e) => {
      const a = e.target.closest('a[href*="wa.me/"]');
      if (!a) return;
      if (a.closest("#lqOverlay") || a.closest("#fkChat") || a.hasAttribute("data-direct-wpp")) return;
      e.preventDefault();
      const trat = a.closest(".art-cta")
        ? (document.querySelector(".art-title")?.textContent || "").trim()
        : "";
      open(trat ? { tratamento: trat } : {});
    });
  })();
</script>
