---
// CTA curto para fechar uma seção da home. Abre o mesmo quiz de lead do QuizCta
// (LeadQuiz, global pelo BaseLayout) e cai no WhatsApp se o quiz não carregar.
// Diferente do QuizCta, que é uma faixa navy de página inteira, este é discreto:
// serve para repetir a oferta ao longo da home sem competir com as faixas.
//   <SectionCta text="..." cta="..." tratamento="Implantes Dentários" />
interface Props {
  text?: string;
  cta?: string;
  tratamento?: string;
}
const {
  text = "",
  cta = "Agendar minha consulta",
  tratamento = "",
} = Astro.props;
---

<div class="sec-cta reveal">
  {text && <p>{text}</p>}
  <button type="button" class="btn btn-primary sec-cta-btn" data-trat={tratamento}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2Zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.6-.1-.4-.1-.9-.3-1.5-.6-2.7-1.2-4.5-3.9-4.6-4.1-.1-.2-1.1-1.4-1.1-2.7 0-1.3.7-1.9 .9-2.2.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.4 0 .5l-.4.6c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2 .8.5 1.1.6 1.4.5.2-.1.4-.4.6-.7.2-.3.4-.2.6-.2l1.7.8c.2.1.4.2.4.4.1.2.1.9-.1 1.5Z"/></svg>
    {cta}
  </button>
</div>

<style is:global>
  .sec-cta{ display:flex; flex-direction:column; align-items:center; gap:14px; text-align:center; margin-top:42px; }
  .sec-cta p{ color:var(--muted); font-size:1rem; max-width:560px; margin:0; }
  .sec-cta-btn{ border:0; cursor:pointer; font-family:'Manrope',sans-serif; }
  @media (max-width:640px){ .sec-cta{ margin-top:32px; } .sec-cta-btn{ width:100%; justify-content:center; } }
</style>

<script>
  document.querySelectorAll(".sec-cta-btn").forEach((b) =>
    b.addEventListener("click", () => {
      const trat = b.dataset.trat;
      if (window.gopQuiz) window.gopQuiz.open(trat ? { tratamento: trat } : {});
      else window.open("https://wa.me/5511985140604", "_blank");
    })
  );
</script>
