---
// CTA curto para fechar uma seção da home: linha de apoio + o par de botões
// padrão (CtaPair). Diferente do QuizCta, que é uma faixa navy de página
// inteira, este é discreto: serve para repetir a oferta ao longo da home sem
// competir com as faixas.
//   <SectionCta text="..." tratamento="Implantes Dentários" />
import CtaPair from "./CtaPair.astro";
interface Props {
  text?: string;
  tratamento?: string;
}
const { text = "", tratamento = "" } = Astro.props;
---

<div class="sec-cta reveal">
  {text && <p>{text}</p>}
  <CtaPair tratamento={tratamento} />
</div>

<style is:global>
  .sec-cta{ display:flex; flex-direction:column; align-items:center; gap:16px; text-align:center; margin-top:42px; }
  .sec-cta p{ color:var(--muted); font-size:1rem; max-width:560px; margin:0; }
  @media (max-width:640px){ .sec-cta{ margin-top:32px; } }
</style>
