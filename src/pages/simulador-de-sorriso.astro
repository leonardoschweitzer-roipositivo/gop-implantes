---
import BaseLayout from "../layouts/BaseLayout.astro";
import SmileSimulator from "../components/SmileSimulator.astro";
import QuizCta from "../components/QuizCta.astro";

const base = "https://gopimplantes.br";
const url = `${base}/simulador-de-sorriso.html`;

const jsonld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Início", item: `${base}/` },
        { "@type": "ListItem", position: 2, name: "Simulador de Sorriso", item: url },
      ],
    },
    {
      "@type": "WebApplication",
      name: "Simulador de Sorriso com IA — GOP Implantes",
      url,
      applicationCategory: "HealthApplication",
      operatingSystem: "Web",
      offers: { "@type": "Offer", price: "0", priceCurrency: "BRL" },
      description:
        "Envie uma foto sorrindo e a inteligência artificial mostra como você ficaria com o dente reposto por implante, preservando suas feições.",
      provider: { "@type": "Dentist", name: "GOP Implantes", areaServed: "São Bernardo do Campo" },
    },
  ],
};

const passos = [
  { n: "1", t: "Envie sua foto", d: "Uma selfie sorrindo, de frente, mostrando o espaço do dente que falta." },
  { n: "2", t: "A IA recria seu sorriso", d: "Em segundos, com o dente reposto — mantendo exatamente as suas feições." },
  { n: "3", t: "Veja seu novo sorriso", d: "Deixe nome e WhatsApp e desbloqueie a imagem nítida na hora. Grátis." },
];

const faqs = [
  { q: "É de verdade?", a: "É uma simulação ilustrativa gerada por inteligência artificial, para você visualizar uma possibilidade. O resultado real é definido em uma avaliação presencial com a nossa equipe." },
  { q: "Minha foto fica guardada?", a: "Não. A imagem é usada apenas para gerar a simulação e enviada à nossa equipe para o atendimento. Não é publicada nem armazenada em banco de dados." },
  { q: "Precisa pagar?", a: "Não. A simulação é gratuita e sem compromisso — é só enviar a foto e seus dados de contato." },
  { q: "Serve para qualquer caso?", a: "A simulação funciona melhor para a falta de um ou poucos dentes visíveis no sorriso. Para casos mais complexos, o ideal é uma avaliação presencial." },
];
---
<BaseLayout
  title="Simulador de Sorriso com IA | GOP Implantes"
  description="Envie uma foto sorrindo e veja, com inteligência artificial, como você ficaria com o dente reposto por implante — preservando suas feições. Grátis, na GOP Implantes (São Bernardo do Campo/SP)."
  canonical={url}
  ogTitle="Veja seu sorriso com o implante — Simulador com IA"
  ogDescription="Envie uma foto e a IA mostra como você ficaria com o dente reposto. Grátis e sem compromisso."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  </Fragment>

  <section class="sec sim-hero">
    <div class="wrap">
      <div class="sec-head reveal" style="max-width:780px">
        <span class="eyebrow">Novo · Inteligência Artificial</span>
        <h1>Veja seu sorriso com o implante</h1>
        <p>Envie uma foto sorrindo e a nossa IA mostra, em segundos, como você ficaria com o dente reposto — mantendo exatamente as suas feições. Grátis e sem compromisso.</p>
      </div>
      <SmileSimulator variant="page" />
    </div>
  </section>

  <!-- COMO FUNCIONA -->
  <section class="sec bg-sand">
    <div class="wrap">
      <div class="sec-head reveal" style="margin-left:auto;margin-right:auto;text-align:center">
        <span class="eyebrow" style="justify-content:center;width:100%">Como funciona</span>
        <h2>Simples assim, em 3 passos</h2>
      </div>
      <div class="ss-steps">
        {passos.map((p) => (
          <div class="ss-step reveal">
            <span class="ss-step-n">{p.n}</span>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head reveal" style="margin-left:auto;margin-right:auto;text-align:center">
        <span class="eyebrow" style="justify-content:center;width:100%">Dúvidas</span>
        <h2>Perguntas frequentes</h2>
      </div>
      <div class="ss-faq reveal">
        {faqs.map((f) => (
          <details class="ss-faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <p class="ss-page-legal reveal">
        Esta ferramenta gera uma simulação ilustrativa por inteligência artificial e não representa
        promessa de resultado. Cada caso é único e o plano de tratamento é definido apenas em
        avaliação clínica presencial.
      </p>
    </div>
  </section>

  <QuizCta
    tratamento="Implantes"
    objetivo="Recuperar um dente perdido"
    title="Curtiu a ideia de recuperar seu sorriso?"
    text="Agende uma avaliação com a nossa equipe e descubra o melhor caminho para o seu caso."
  />
</BaseLayout>

<style>
  .sim-hero{ padding-top:130px; }
  .sim-hero h1{ font-family:'Poppins',sans-serif; font-weight:500; font-size:clamp(2rem,4.4vw,3.2rem); color:var(--navy-deep); margin:16px 0 14px; line-height:1.08; letter-spacing:-.01em; }
  .sim-hero .sec-head{ margin-bottom:34px; }
  .sim-hero .sec-head p{ color:var(--muted); font-size:1.05rem; }

  .ss-steps{ display:grid; grid-template-columns:repeat(3,1fr); gap:22px; }
  .ss-step{ background:#fff; border:1px solid var(--line); border-radius:var(--radius); padding:30px 26px; text-align:center; }
  .ss-step-n{ display:inline-grid; place-items:center; width:44px; height:44px; border-radius:50%; background:linear-gradient(135deg,var(--navy),var(--teal)); color:#fff; font-family:'Poppins',serif; font-size:1.3rem; margin-bottom:14px; }
  .ss-step h3{ font-family:'Poppins',sans-serif; color:var(--navy-deep); font-size:1.25rem; margin:0 0 8px; }
  .ss-step p{ color:var(--muted); font-size:.96rem; line-height:1.55; margin:0; }

  .ss-faq{ max-width:760px; margin:0 auto; display:flex; flex-direction:column; gap:12px; }
  .ss-faq-item{ background:#fff; border:1px solid var(--line); border-radius:16px; overflow:hidden; }
  .ss-faq-item summary{ list-style:none; cursor:pointer; padding:20px 24px; font-weight:600; color:var(--navy-deep); font-size:1.02rem; }
  .ss-faq-item summary::-webkit-details-marker{ display:none; }
  .ss-faq-item[open] summary{ color:var(--teal); }
  .ss-faq-item p{ padding:0 24px 20px; margin:0; color:var(--muted); line-height:1.65; }
  .ss-page-legal{ max-width:760px; margin:30px auto 0; text-align:center; font-size:.82rem; color:var(--muted); line-height:1.6; }

  @media (max-width:820px){ .ss-steps{ grid-template-columns:1fr; } }
</style>
